{
  "name": "pq-test-app",
  "version": "0.0.1",
  "private": true,
  "description": "Capacitor test harness for pq-secure-storage-plugin (web fallback + iOS/Android).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync": "cap sync",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "e2e:ios": "./scripts/e2e.sh ios",
    "e2e:android": "./scripts/e2e.sh android",
    "wdio:ios": "E2E_PLATFORM=ios wdio run ./wdio.conf.ts",
    "wdio:android": "E2E_PLATFORM=android wdio run ./wdio.conf.ts"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "pq-secure-storage-plugin": "file:.."
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.16.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^3.5.0",
    "appium-uiautomator2-driver": "^8.1.0",
    "appium-xcuitest-driver": "^11.17.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "webdriverio": "^9.0.0"
  }
}
